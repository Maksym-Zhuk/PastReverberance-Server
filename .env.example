# --- Server ---
PORT=8080

# --- Postgres ---
# Neon / Supabase / any cloud Postgres: copy the connection string from the dashboard.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Cloud Postgres needs SSL (default). Set to false only for a local database.
DATABASE_SSL=true

# --- JWT ---
# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-access-secret
JWT_EXPIRE_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret-different-from-access
REFRESH_JWT_EXPIRE_IN=30d

# --- Cloudinary (photo uploads) ---
# Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
